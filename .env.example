# Copy to .env next to docker-compose.yml. The installer writes OCHE_IMAGE and
# OCHE_RESTART_POLICY here and keeps every other line.
OCHE_IMAGE=mondeggo/oche:latest
OCHE_RESTART_POLICY=unless-stopped
OCHE_PORT=80
OCHE_HTTPS_PORT=443
# Release manifest for in-app updates; set it empty to turn update discovery off.
# OCHE_UPDATE_FEED=https://github.com/mondeggo/oche/releases/latest/download/updates.json
# Optional startup overrides; leave empty to configure your account in Oche.
OCHE_CORE_CLIENT_ID=
OCHE_CORE_BOARD_ID=
# The detector runs in Oche by default. A separate LAN board can be selected here.
OCHE_CORE_LOCAL_AUTODARTS_URL=http://127.0.0.1:3180
