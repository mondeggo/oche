# Copy to .env at the repository root for local development.
# GitHub token with Contents: read access to mondeggo/AutoGlow2.
AUTOGLOW_TOKEN=

# Optional: pin AutoGlow to a full commit SHA; empty uses the default branch.
AUTOGLOW_VERSION=

# Optional HTTPS port. Enable certificate generation in Oche Settings.
OCHE_HTTPS_PORT=443

# Optional: use another trusted acme-dns service for new registrations.
OCHE_ACME_DNS_URL=https://auth.acme-dns.io
